PORT=4000

# Firebase project ID used for Firebase ID token verification (JWKS-based)
FIREBASE_PROJECT_ID=myapplication-dc877d91

# AWS credentials for signing presigned URLs (server-side only)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Optional CDN/public URL base for saved files
# AWS_S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com

# Optional signed URL expiry seconds (default 300)
# SIGNED_URL_TTL_SECONDS=300
